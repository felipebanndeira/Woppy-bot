# Variables de entorno para Wopyy Nails & Lashes

# Entorno y URL base
NODE_ENV=production
APP_URL=https://tu-app-en-render.onrender.com
PORT=3000

# Base de datos PostgreSQL (Render, Supabase o Neon)
DATABASE_URL="postgresql://usuario:password@host:5432/dbname?sslmode=require"

# Primer administrador para acceder al panel
ADMIN_EMAIL=admin@wopyy.com
ADMIN_PASSWORD=AdminSeguro123!

# Cifrado AES-256-GCM para tokens de integraciones (32 bytes en formato hex)
ENCRYPTION_KEY=c3ab89f71b3e944d567123456789abcdef0123456789abcdef0123456789abcdef

# Clave secreta para firmar sesiones y JWT
AUTH_SECRET=f9d45e67a12b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d

# IA con OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-tu-clave-aqui
OPENROUTER_DEFAULT_MODEL=google/gemini-2.0-flash-001

# WhatsApp (Baileys) - Directorio en disco para la sesión
WHATSAPP_SESSION_DIR=/opt/render/project/src/data/whatsapp_session

# Google Cloud OAuth (Opcional - Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tu-app-en-render.onrender.com/api/integrations/google/callback

# Slack Webhook (Opcional)
SLACK_WEBHOOK_URL=

# Stripe (Opcional)
STRIPE_SECRET_KEY=

# Clave secreta para webhooks
WEBHOOK_SIGNING_SECRET=whsec_wopyy_super_secreto_2026

# Cargar automáticamente los servicios y configuración de Wopyy Nails & Lashes
SEED_DEMO=true
