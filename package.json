{
  "name": "atiende",
  "version": "1.0.0",
  "description": "Asistente de IA para negocios locales que atiende por WhatsApp y chat web",
  "main": "index.js",
  "scripts": {
    "dev:db": "npx prisma dev -n atiende -P 5432 --shadow-db-port 5433",
    "dev:web": "next dev",
    "dev:worker": "tsx src/worker/index.ts",
    "dev": "concurrently -n \"db,web,worker\" -c \"blue,green,magenta\" \"npm run dev:db\" \"npm run dev:web\" \"npm run dev:worker\"",
    "build": "next build",
    "start": "node runner.js",
    "worker": "tsx src/worker/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx src/scripts/seed.ts"
  },
  "keywords": [
    "ai",
    "whatsapp",
    "baileys",
    "calendar",
    "openrouter",
    "nextjs"
  ],
  "author": "Atiende",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^6.19.3",
    "@slack/webhook": "^8.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^6.7.24",
    "autoprefixer": "^10.6.2",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.9",
    "googleapis": "^189.0.0",
    "jimp": "^1.6.1",
    "link-preview-js": "^3.0.0",
    "lucide-react": "^1.65.0",
    "next": "^16.4.3",
    "openai": "^7.45.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
